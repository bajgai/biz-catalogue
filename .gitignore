# Only reviewed project surfaces are eligible for publication.
/*
!/.gitignore
!/.gitleaks.toml
!/.public-repo-policy.json
!/.githooks/
!/.github/
!/AGENTS.md
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CONTEXT.md
!/docs/
!/scripts/
!/tests/

# Private operational data and runtime state are never source code.
**/.env
**/.env.*
!**/.env.example
**/private/
**/data/
**/datasets/
**/exports/
**/backups/
**/secrets/
**/credentials/
**/.scratch/
**/node_modules/
**/__pycache__/
**/.DS_Store
*.pyc
*.db
*.sqlite*
*.sql
*.dump
*.bak
*.csv
*.tsv
*.jsonl
*.ndjson
*.parquet
*.arrow
*.xlsx
*.xls
*.zip
*.tar
*.gz
*.7z
*.pem
*.key
*.p12
*.pfx
*.tfstate*
